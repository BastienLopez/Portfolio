# Configuration Caddy de référence pour le déploiement VPS.
#
# Le bloc handle_errors sert 404.html avec le statut d'erreur conservé :
# une route inconnue affiche la page React NotFound tout en répondant 404.

{
	admin unix//var/lib/caddy/caddy-admin.sock|0600
	servers {
		timeouts {
			read_header 10s
			idle 2m
		}
		max_header_size 32KiB
		0rtt off
		protocols h1 h2
		strict_sni_host on
	}
}

(security_headers) {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"

		# CSP active : vérifiée sur Chrome après le parcours local et live.
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self' blob:"
	}
}

bastienlopez.fr {
	root * /var/www/bastienlopez.fr
	import security_headers
	encode zstd gzip

	@badmethod {
		not method GET HEAD
	}
	@probe path /.env* /.git* /wp-admin* /wp-login.php* /xmlrpc.php* /phpmyadmin* /vendor/phpunit* /cgi-bin* /server-status* /actuator*

	respond @badmethod 405
	respond @probe 404

	# Une seule forme canonique : les URLs publiées sont sans slash final.
	@trailingSlash path_regexp trailingSlash ^/(freelance|mentions-legales|projets/[^/]+|services/[^/]+|notes/[^/]+)/$
	redir @trailingSlash https://bastienlopez.fr/{re.trailingSlash.1} 301

	# La racine et les pages prérendues sont servies directement afin que
	# chaque URL conserve son HTML et ses métadonnées propres.
	@root path /
	handle @root {
		file_server
	}

	@prerendered path /freelance /freelance/ /mentions-legales /mentions-legales/ /projets/altme-wallet-provider /projets/altme-wallet-provider/ /projets/automatisations-n8n-reporting /projets/automatisations-n8n-reporting/ /projets/automatisations-n8n-derush-video /projets/automatisations-n8n-derush-video/ /projets/altme-wallet-platform /projets/altme-wallet-platform/ /projets/altme-documentation /projets/altme-documentation/ /projets/teams-bot-mastra /projets/teams-bot-mastra/ /projets/seo-geo-optimization /projets/seo-geo-optimization/ /projets/eloi-coachsteo /projets/eloi-coachsteo/ /projets/erp-micro-creches /projets/erp-micro-creches/ /projets/luxury-auto-detailing /projets/luxury-auto-detailing/ /projets/cledevoute /projets/cledevoute/ /projets/berserk-universe /projets/berserk-universe/ /projets/codex-limits-usage /projets/codex-limits-usage/ /projets/pokemon-binder /projets/pokemon-binder/ /projets/ia-trading /projets/ia-trading/ /projets/patripro /projets/patripro/ /projets/ats-filter-resume /projets/ats-filter-resume/ /projets/novotel-roue-chance /projets/novotel-roue-chance/ /projets/aqualis /projets/aqualis/ /projets/nolvus-mod-automation /projets/nolvus-mod-automation/ /projets/bloodborne-shadps4 /projets/bloodborne-shadps4/ /projets/demons-souls-rpcs3 /projets/demons-souls-rpcs3/ /services/sites-vitrines /services/sites-vitrines/ /services/applications-metier /services/applications-metier/ /services/automatisations-n8n /services/automatisations-n8n/ /notes/pipeline-ci-cd-github-actions /notes/pipeline-ci-cd-github-actions/ /notes/docker-pour-debutants /notes/docker-pour-debutants/ /notes/monitorer-une-application-apres-deploiement /notes/monitorer-une-application-apres-deploiement/ /notes/architecture-hexagonale /notes/architecture-hexagonale/ /notes/deploiement-production-checklist /notes/deploiement-production-checklist/ /notes/gerer-secrets-cles-api-local /notes/gerer-secrets-cles-api-local/ /notes/refactoring-sans-tout-casser /notes/refactoring-sans-tout-casser/ /notes/estimer-un-projet-freelance /notes/estimer-un-projet-freelance/ /notes/creer-site-internet-entreprise-cadrage /notes/creer-site-internet-entreprise-cadrage/ /notes/automatiser-processus-entreprise-n8n-cadrage /notes/automatiser-processus-entreprise-n8n-cadrage/
	handle @prerendered {
		try_files {path}/index.html {path}index.html
		file_server
	}

	# Les fichiers existants restent servis normalement. Une ressource ou
	# une route absente déclenche l'erreur 404 ci-dessous.
	handle {
		try_files {path} {path}/ =404
		file_server
	}

	# Caddy conserve le statut 404 tout en servant l'UI React NotFound prérendue.
	handle_errors 404 {
		import security_headers
		rewrite * /404.html
		file_server
	}

	log {
		output file /var/log/caddy/bastienlopez.fr-access.log {
			mode 0640
			roll_size 10MiB
			roll_keep 14
			roll_keep_for 336h
		}
		format json
	}
}

www.bastienlopez.fr {
	import security_headers
	redir https://bastienlopez.fr{uri} permanent
}
