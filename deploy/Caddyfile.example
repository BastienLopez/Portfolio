# Configuration Caddy de référence pour le déploiement VPS.
#
# Le bloc handle_errors sert 404.html avec le statut d'erreur conservé :
# une route inconnue affiche la page React NotFound tout en répondant 404.

{
	admin unix//var/lib/caddy/caddy-admin.sock|0600
	servers {
		timeouts {
			read_header 10s
			idle 2m
		}
		max_header_size 32KiB
		0rtt off
		protocols h1 h2
		strict_sni_host on
	}
}

(security_headers) {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Cross-Origin-Opener-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"

		# CSP stricte : les sinks HTML utilisent la policy Trusted Types portfolio-html.
		# La phase report-only a été validée localement avant l'enforcement ci-dessous.
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self'; style-src-attr 'none'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self' blob:; trusted-types default portfolio-html dompurify; require-trusted-types-for 'script'"
	}
}

bastienlopez.fr {
	root * /var/www/bastienlopez.fr
	import security_headers
	encode zstd gzip

	# Les assets Vite portent des noms fingerprintés : ils peuvent être
	# conservés longtemps sans servir une version obsolète après un déploiement.
	@immutableAssets path /assets/*
	header @immutableAssets Cache-Control "public, max-age=31536000, immutable"

	# Les images, polices et icônes publiques ne sont pas toutes fingerprintées;
	# un cache long mais revalidable évite de figer une ancienne version.
	@stableAssets path /fonts/* /img_optimized/* /img_clients/* /img_projects/* /favicon.ico /icon-192.png /icon-512.png /og-image.png /og-image.svg
	header @stableAssets Cache-Control "public, max-age=604800"

	# Les fichiers de découverte peuvent changer sans nécessiter un nouveau
	# build des assets ; une revalidation horaire suffit.
	@metadataFiles path /robots.txt /sitemap.xml /llms.txt /site.webmanifest
	header @metadataFiles Cache-Control "public, max-age=3600"

	@badmethod {
		not method GET HEAD
	}
	@probe path /.env* /.git* /wp-admin* /wp-login.php* /xmlrpc.php* /phpmyadmin* /vendor/phpunit* /cgi-bin* /server-status* /actuator*

	respond @badmethod 405
	respond @probe 404

	# L’ancien détail sites vitrines est conservé comme URL de compatibilité,
	# mais toute la fiche vitrine vit désormais sur la page locale canonique.
	@legacySitesVitrines path /services/sites-vitrines /services/sites-vitrines/
	redir @legacySitesVitrines https://bastienlopez.fr/creation-site-internet-reims 301

	# Une seule forme canonique : les URLs publiées sont sans slash final.
	@trailingSlash path_regexp trailingSlash ^/(freelance|creation-site-internet-reims|mentions-legales|projets/[^/]+|services/[^/]+|notes/[^/]+)/$
	redir @trailingSlash https://bastienlopez.fr/{re.trailingSlash.1} 301

	# La racine et les pages prérendues sont servies directement afin que
	# chaque URL conserve son HTML et ses métadonnées propres.
	@root path /
	handle @root {
		file_server
	}

	@prerendered path /freelance /freelance/ /creation-site-internet-reims /creation-site-internet-reims/ /mentions-legales /mentions-legales/ /projets/altme-wallet-provider /projets/altme-wallet-provider/ /projets/automatisations-n8n-reporting /projets/automatisations-n8n-reporting/ /projets/automatisations-n8n-derush-video /projets/automatisations-n8n-derush-video/ /projets/altme-wallet-platform /projets/altme-wallet-platform/ /projets/altme-documentation /projets/altme-documentation/ /projets/teams-bot-mastra /projets/teams-bot-mastra/ /projets/seo-geo-optimization /projets/seo-geo-optimization/ /projets/eloi-coachsteo /projets/eloi-coachsteo/ /projets/erp-micro-creches /projets/erp-micro-creches/ /projets/luxury-auto-detailing /projets/luxury-auto-detailing/ /projets/cledevoute /projets/cledevoute/ /projets/berserk-universe /projets/berserk-universe/ /projets/codex-limits-usage /projets/codex-limits-usage/ /projets/pokemon-binder /projets/pokemon-binder/ /projets/ia-trading /projets/ia-trading/ /projets/patripro /projets/patripro/ /projets/ats-filter-resume /projets/ats-filter-resume/ /projets/novotel-roue-chance /projets/novotel-roue-chance/ /projets/aqualis /projets/aqualis/ /projets/nolvus-mod-automation /projets/nolvus-mod-automation/ /projets/bloodborne-shadps4 /projets/bloodborne-shadps4/ /projets/demons-souls-rpcs3 /projets/demons-souls-rpcs3/ /services/applications-metier /services/applications-metier/ /services/automatisations-n8n /services/automatisations-n8n/ /notes/pipeline-ci-cd-github-actions /notes/pipeline-ci-cd-github-actions/ /notes/docker-pour-debutants /notes/docker-pour-debutants/ /notes/monitorer-une-application-apres-deploiement /notes/monitorer-une-application-apres-deploiement/ /notes/architecture-hexagonale /notes/architecture-hexagonale/ /notes/deploiement-production-checklist /notes/deploiement-production-checklist/ /notes/gerer-secrets-cles-api-local /notes/gerer-secrets-cles-api-local/ /notes/refactoring-sans-tout-casser /notes/refactoring-sans-tout-casser/ /notes/estimer-un-projet-freelance /notes/estimer-un-projet-freelance/ /notes/creer-site-internet-entreprise-cadrage /notes/creer-site-internet-entreprise-cadrage/ /notes/automatiser-processus-entreprise-n8n-cadrage /notes/automatiser-processus-entreprise-n8n-cadrage/
	handle @prerendered {
		try_files {path}/index.html {path}index.html
		file_server
	}

	# Les fichiers existants restent servis normalement. Une ressource ou
	# une route absente déclenche l'erreur 404 ci-dessous.
	handle {
		try_files {path} {path}/ =404
		file_server
	}

	# Caddy conserve le statut 404 tout en servant l'UI React NotFound prérendue.
	handle_errors 404 {
		import security_headers
		rewrite * /404.html
		file_server
	}

	log {
		output file /var/log/caddy/bastienlopez.fr-access.log {
			mode 0640
			roll_size 10MiB
			roll_keep 14
			roll_keep_for 336h
		}
		format json
	}
}

www.bastienlopez.fr {
	import security_headers
	redir https://bastienlopez.fr{uri} permanent
}
